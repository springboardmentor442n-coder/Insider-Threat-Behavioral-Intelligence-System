# ============================================================================
# Application Settings
# ============================================================================
APP_NAME=Insider Threat Behavioral Intelligence System
APP_VERSION=1.0.0
APP_DESCRIPTION=Enterprise Behavioral Intelligence REST API
APP_ENV=development
APP_DEBUG=false

# ============================================================================
# Security / JWT Settings
# ============================================================================
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
OAUTH2_TOKEN_URL=/auth/login

# ============================================================================
# CORS Settings
# ============================================================================
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*
CORS_ALLOW_ALL_ORIGINS=true
CORS_ALLOWED_ORIGINS=

# ============================================================================
# Logging Settings
# ============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s | %(levelname)s | %(message)s

# ============================================================================
# Future Integration Placeholders
# ============================================================================
DATABASE_URL=postgresql://user:password@localhost:5432/insider_threat
REDIS_URL=redis://localhost:6379/0
OBJECT_STORAGE_URL=http://localhost:9000

# ============================================================================
# Path Settings
# ============================================================================
PROJECT_ROOT=
BACKEND_DIR_NAME=backend
REPORTS_DIR_NAME=reports
MODELS_DIR_NAME=models
PLOTS_DIR_NAME=plots
DATASETS_DIR_NAME=datasets
BACKEND_DATA_DIR_NAME=data
BACKEND_MODELS_DIR_NAME=models
USERS_FILE_NAME=users.json
