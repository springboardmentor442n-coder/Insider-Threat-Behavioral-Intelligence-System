# ---------------------------------------------------------------------------
# TEMPLATE - copy this file to `.env` and fill in real values.
#
# `.env.example` IS committed to git (so anyone cloning the repo knows which
# variables they need to set). `.env` is NOT committed - it holds real values.
# This is the standard way to document config without leaking secrets.
# ---------------------------------------------------------------------------

# --- Application -------------------------------------------------------------
APP_NAME="Insider Threat Behavioral Intelligence System"
APP_ENV=development
DEBUG=true

# --- Database ----------------------------------------------------------------
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
# These values match the Docker container created in Phase 0 setup.
DATABASE_URL=postgresql://itbis_user:itbis_dev_password@localhost:5432/insider_threat_db

# --- Data --------------------------------------------------------------------
# Where the extracted CERT r4.2 dataset lives (relative to the project root).
CERT_DATA_DIR=data